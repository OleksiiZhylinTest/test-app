<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Design Complexity Audit</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 2rem; color: #222; }
    h1 { font-size: 1.6rem; }
    h2 { font-size: 1.2rem; margin-top: 2rem; border-bottom: 1px solid #ddd; padding-bottom: .3rem; }
    h3 { font-size: 1rem; margin-top: 1.2rem; color: #444; }
    table { border-collapse: collapse; width: 100%; font-size: .9rem; }
    th, td { border: 1px solid #ddd; padding: .4rem .7rem; text-align: left; }
    th { background: #f5f5f5; }
    tr:nth-child(even) { background: #fafafa; }
    .badge-High { background: #fee2e2; color: #991b1b; border-radius: 4px; padding: 2px 6px; }
    .badge-Medium { background: #fef9c3; color: #854d0e; border-radius: 4px; padding: 2px 6px; }
    .badge-Low { background: #dcfce7; color: #166534; border-radius: 4px; padding: 2px 6px; }
    .badge-Error { background: #f3f4f6; color: #6b7280; border-radius: 4px; padding: 2px 6px; }
    ul { margin: .3rem 0 .8rem 1.2rem; }
  </style>
</head>
<body>
  <h1>Design Complexity Audit</h1>
  <p>Generated: {{ report.generated_at }} &mdash; Modules scanned: {{ report.module_count }}
    (High: {{ report.summary.high_count }},
     Medium: {{ report.summary.medium_count }},
     Low: {{ report.summary.low_count }},
     Errors: {{ report.summary.error_count }})</p>

  <h2>Module Scores</h2>
  <table>
    <thead>
      <tr>
        <th>Module</th><th>LOC</th><th>Functions</th><th>CC</th>
        <th>LOC Score</th><th>Coupling</th><th>Cohesion</th>
        <th>Composite</th><th>Class</th>
      </tr>
    </thead>
    <tbody>
      {% for score in report.scores %}
      <tr>
        {% if score.classification == "Error" %}
        <td>{{ score.module }}</td>
        <td colspan="7" style="color:#9ca3af">parse error: {{ score.error }}</td>
        <td><span class="badge-Error">Error</span></td>
        {% else %}
        <td>{{ score.module }}</td>
        <td>{{ score.loc }}</td>
        <td>{{ score.function_count }}</td>
        <td>{{ "%.1f"|format(score.cc_score) }}</td>
        <td>{{ "%.1f"|format(score.loc_score) }}</td>
        <td>{{ "%.1f"|format(score.coupling_score) }}</td>
        <td>{{ "%.1f"|format(score.cohesion_score) }}</td>
        <td>{{ "%.2f"|format(score.composite_score) }}</td>
        <td><span class="badge-{{ score.classification }}">{{ score.classification }}</span></td>
        {% endif %}
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Improvement Plan</h2>
  {% if report.recommendations %}
    {% set ns = namespace(current_module=None) %}
    {% for rec in report.recommendations %}
      {% if rec.module != ns.current_module %}
        {% if ns.current_module is not none %}</ul>{% endif %}
        {% set ns.current_module = rec.module %}
        <h3>{{ rec.module }}</h3>
        <ul>
      {% endif %}
      <li>{{ rec.action }}</li>
    {% endfor %}
    </ul>
  {% else %}
    <p>No high-complexity modules found.</p>
  {% endif %}
</body>
</html>
