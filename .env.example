# =============================================================================
# Jira Connection — Credentials
# Required. Get your API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Copy this file to .env and fill in your values. Never commit .env.
#
# All other configuration (sprint count, metric toggles, AI labels, etc.) lives in
# config/defaults.env — already committed and active for every developer.
# Override any of those values here when you need instance-specific settings.
# =============================================================================

# Jira Cloud base URL — do not include a trailing slash
JIRA_URL=

# Email address associated with your Atlassian account
JIRA_EMAIL=

# Atlassian API token (never your password)
JIRA_API_TOKEN=


# =============================================================================
# Confluence Credentials (optional)
# Only needed if your Confluence uses a different account from your Jira account.
# If both share the same Atlassian account, leave these blank.
# =============================================================================

# Example: CONFLUENCE_EMAIL=confluence-user@your-company.com
# CONFLUENCE_EMAIL=

# CONFLUENCE_API_TOKEN=


# SSL / TLS Certificate setup → see config/defaults.env
